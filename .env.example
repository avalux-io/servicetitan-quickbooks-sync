# ServiceTitan Tenant API credentials
# Found in Settings > Integrations > API Application Access in your ServiceTitan tenant.
# You will need admin rights or to have your ServiceTitan CSM enable API access.
SERVICETITAN_TENANT_ID=1234567890
SERVICETITAN_CLIENT_ID=cid.xxxxxxxxxxxxxxxx
SERVICETITAN_CLIENT_SECRET=cs1.xxxxxxxxxxxxxxxx
SERVICETITAN_APP_KEY=ak1.xxxxxxxxxxxxxxxx
SERVICETITAN_ENV=production  # or integration for the sandbox tenant

# QuickBooks Online API credentials
# Create an app at https://developer.intuit.com and connect it to the target QBO company.
# Realm ID is the company ID and is shown after the OAuth consent flow.
QBO_CLIENT_ID=ABxxxxxxxxxxxxxxxx
QBO_CLIENT_SECRET=xxxxxxxxxxxxxxxx
QBO_REALM_ID=1234567890123456789
QBO_REFRESH_TOKEN=ABxxxxxxxxxxxxxxxx
QBO_ENV=production  # or sandbox

# Sync configuration
SYNC_LEDGER_PATH=state/ledger.db
SYNC_ACCOUNT_MAPPING_PATH=config/account_mapping.yaml
SYNC_DEFAULT_WINDOW_HOURS=24
SYNC_LOG_LEVEL=INFO

# Optional: alerting webhook for reconciliation failures
ALERT_WEBHOOK_URL=
